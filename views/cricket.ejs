  <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cricket Player Registration</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<div class="container2">

    <div class="form-header">
        <h1>🏏 Cricket Player Registration</h1>
        <p>Register yourself for the cricket team selection</p>
    </div>

    <form id="cricketForm">

        <!-- Personal Details -->
        <h2 class="h">Personal Details</h2>

        <div class="row">
            <div class="input-group">
                <label>Player Name</label>
                <input type="text" id="name" placeholder="Enter your name" required>
            </div>

            <div class="input-group">
                <label>Date of Birth</label>
                <input type="date" id="dob" required>
            </div>
        </div>

        <div class="row">
            <div class="input-group">
                <label>Mobile Number</label>
                <input type="tel" id="mobile"
                       placeholder="Enter mobile number"
                       pattern="[0-9]{10}" required>
            </div>

            <div class="input-group">
                <label>Email</label>
                <input type="email" id="email"
                       placeholder="Enter email" required>
            </div>
        </div>

        <div class="input-group">
            <label>Address</label>
            <textarea id="address"
                      placeholder="Enter your address"
                      rows="3" required></textarea>
        </div>


        <!-- Cricket Details -->
        <h2>Cricket Details</h2>

        <div class="input-group">
            <label>Playing Role</label>

            <div class="radio-group">
                <label>
                    <input type="radio" name="role" value="Batsman" required>
                    Batsman
                </label>

                <label>
                    <input type="radio" name="role" value="Bowler">
                    Bowler
                </label>

                <label>
                    <input type="radio" name="role" value="All-Rounder">
                    All-Rounder
                </label>

                <label>
                    <input type="radio" name="role" value="Wicket Keeper">
                    Wicket Keeper
                </label>
            </div>
        </div>


        <div class="row">

            <div class="input-group">
                <label>Batting Style</label>

                <select id="batting" required>
                    <option value="">Select batting style</option>
                    <option>Right Hand</option>
                    <option>Left Hand</option>
                </select>
            </div>

            <div class="input-group">
                <label>Bowling Style</label>

                <select id="bowling" required>
                    <option value="">Select bowling style</option>
                    <option>Right Arm Fast</option>
                    <option>Left Arm Fast</option>
                    <option>Right Arm Medium</option>
                    <option>Left Arm Medium</option>
                    <option>Right Arm Spin</option>
                    <option>Left Arm Spin</option>
                    <option>None</option>
                </select>
            </div>

        </div>


        <div class="row">

            <div class="input-group">
                <label>Playing Experience</label>

                <select id="experience" required>
                    <option value="">Select experience</option>
                    <option>Beginner</option>
                    <option>1-2 Years</option>
                    <option>3-5 Years</option>
                    <option>5+ Years</option>
                </select>
            </div>

            <div class="input-group">
                <label>Jersey Number</label>
                <input type="number"
                       id="jersey"
                       placeholder="e.g. 18"
                       min="1"
                       max="99"
                       required>
            </div>

        </div>


        <!-- Skills -->
        <h2>Additional Skills</h2>

        <div class="checkbox-group">

            <label>
                <input type="checkbox" value="Batting">
                Batting
            </label>

            <label>
                <input type="checkbox" value="Bowling">
                Bowling
            </label>

            <label>
                <input type="checkbox" value="Fielding">
                Fielding
            </label>

            <label>
                <input type="checkbox" value="Wicket Keeping">
                Wicket Keeping
            </label>

        </div>


        <button type="submit">Register Player 🏏</button>

    </form>

    <div id="successMessage"></div>

</div>

<script>
  const form = document.getElementById("cricketForm");
  const successMessage = document.getElementById("successMessage");

  form.addEventListener("submit", function(event) {

    event.preventDefault();

    const name = document.getElementById("name").value;

    successMessage.innerHTML =
        `🏏 Registration Successful!<br>
         Welcome ${name} to the cricket team selection.`;

    form.reset();
});
</script>

</body>
</html>
</body>
</html>