<%- include('partial/head') %>

<style>
    .container2 {
        max-width: 760px;
        margin: 35px auto;
        background: #fff;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        font-family: Arial, sans-serif;
    }

    .header2 {
        background: linear-gradient(135deg, #ff9800, #ff5722);
        color: white;
        text-align: center;
        padding: 25px 15px;
    }

    .header2 h2 {
        margin: 0 0 8px;
        font-size: 28px;
    }

    .header2 p {
        margin: 0;
    }

    .form-content {
        padding: 25px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .input-group {
        margin-bottom: 18px;
    }

    .input-group label {
        display: block;
        margin-bottom: 7px;
        font-weight: bold;
        color: #333;
    }

    .input-group input,
    .input-group select,
    .input-group textarea {
        width: 100%;
        padding: 11px;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-sizing: border-box;
        font-size: 14px;
        outline: none;
    }

    .input-group input:focus,
    .input-group select:focus,
    .input-group textarea:focus {
        border-color: #ff9800;
        box-shadow: 0 0 5px rgba(255,152,0,0.3);
    }

    .input-group textarea {
        resize: vertical;
    }

    .checkbox-group {
        margin: 15px 0;
        color: #333;
    }

    .checkbox-group input {
        margin-right: 7px;
    }

    .btn-group {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }

    .btn-group button {
        flex: 1;
        padding: 12px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
    }

    .submit-btn {
        background: #ff9800;
        color: white;
    }

    .submit-btn:hover {
        background: #f57c00;
    }

    .reset-btn {
        background: #e0e0e0;
        color: #333;
    }

    .success-message {
        display: none;
        background: #e8f5e9;
        color: #2e7d32;
        padding: 15px;
        margin-top: 20px;
        border-radius: 6px;
        text-align: center;
    }

    .footer2 {
        background: #fff3e0;
        color: #555;
        text-align: center;
        padding: 15px;
        font-size: 13px;
    }

    @media (max-width: 600px) {
        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .container2 {
            margin: 15px;
        }

        .form-content {
            padding: 18px;
        }
    }
</style>

</head>
<body>
  <header class="bg-red-500 text-white p-4 shadow-md">
    <nav class="container mx-auto flex justify-between items-center">
      <ul class="flex space-x-4">
        
        <li>
          <a href="/home" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Home</a>
        </li>
        <li>
          <a href="/dancing"><h2 class="Logo">Dancing</h2></a>
        </li>
        <li>
          <a href="/singing" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Singing</a>
        </li>
        <li>
          <a href="/shayari" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Shayari</a>
        </li>
      </ul>
    </nav>
  </header>
<div class="container2">

    <div class="header2">
        <h2>🎤 Shayari Registration</h2>
        <p>Register yourself for the Shayari Competition</p>
    </div>

    <div class="form-content">

        <form id="shayariForm">

            <h3>Participant Information</h3>
            <br>

            <div class="form-row">
                <div class="input-group">
                    <label for="fullName">Full Name *</label>
                    <input type="text" id="fullName"
                           name="fullName"
                           placeholder="Enter your full name"
                           required>
                </div>

                <div class="input-group">
                    <label for="email">Email Address *</label>
                    <input type="email" id="email"
                           name="email"
                           placeholder="Enter your email"
                           required>
                </div>

                <div class="input-group">
                    <label for="mobile">Mobile Number *</label>
                    <input type="tel" id="mobile"
                           name="mobile"
                           placeholder="10-digit mobile number"
                           pattern="[0-9]{10}"
                           maxlength="10"
                           required>
                </div>

                <div class="input-group">
                    <label for="age">Age *</label>
                    <input type="number" id="age"
                           name="age"
                           min="10" max="100"
                           placeholder="Enter your age"
                           required>
                </div>

                <div class="input-group">
                    <label for="gender">Gender *</label>
                    <select id="gender" name="gender" required>
                        <option value="">Select Gender</option>
                        <option>Male</option>
                        <option>Female</option>
                        <option>Other</option>
                        <option>Prefer not to say</option>
                    </select>
                </div>

                <div class="input-group">
                    <label for="college">College / Institution *</label>
                    <input type="text" id="college"
                           name="college"
                           placeholder="Enter college name"
                           required>
                </div>
            </div>

            <hr>
            <br>

            <h3>Shayari Competition Details</h3>
            <br>

            <div class="form-row">
                <div class="input-group">
                    <label for="shayariType">Shayari Type *</label>
                    <select id="shayariType" name="shayariType" required>
                        <option value="">Select Shayari Type</option>
                        <option>Romantic</option>
                        <option>Motivational</option>
                        <option>Sad</option>
                        <option>Comedy</option>
                        <option>Friendship</option>
                        <option>Desh Bhakti</option>
                        <option>Nature</option>
                        <option>Other</option>
                    </select>
                </div>

                <div class="input-group">
                    <label for="language">Language *</label>
                    <select id="language" name="language" required>
                        <option value="">Select Language</option>
                        <option>Hindi</option>
                        <option>Urdu</option>
                        <option>English</option>
                        <option>Hinglish</option>
                        <option>Bhojpuri</option>
                        <option>Maithili</option>
                        <option>Other</option>
                    </select>
                </div>

                <div class="input-group">
                    <label for="level">Competition Level *</label>
                    <select id="level" name="level" required>
                        <option value="">Select Level</option>
                        <option>College</option>
                        <option>District</option>
                        <option>State</option>
                        <option>National</option>
                    </select>
                </div>

                <div class="input-group">
                    <label for="performanceType">Performance Type *</label>
                    <select id="performanceType"
                            name="performanceType" required>
                        <option value="">Select Type</option>
                        <option>Self-Written Shayari</option>
                        <option>Recitation</option>
                        <option>Both</option>
                    </select>
                </div>

                <div class="input-group">
                    <label for="title">Shayari Title *</label>
                    <input type="text" id="title"
                           name="title"
                           placeholder="Enter your shayari title"
                           required>
                </div>

                <div class="input-group">
                    <label for="duration">Performance Duration *</label>
                    <select id="duration" name="duration" required>
                        <option value="">Select Duration</option>
                        <option>1–2 Minutes</option>
                        <option>2–3 Minutes</option>
                        <option>3–5 Minutes</option>
                        <option>More than 5 Minutes</option>
                    </select>
                </div>
            </div>

            <div class="input-group">
                <label for="shayari">Your Shayari / Performance Details *</label>
                <textarea id="shayari" name="shayari"
                          rows="5"
                          placeholder="Write your shayari or describe your performance..."
                          required></textarea>
            </div>

            <div class="input-group">
                <label for="experience">Previous Experience</label>
                <select id="experience" name="experience">
                    <option value="">Select Experience</option>
                    <option>Beginner</option>
                    <option>Participated in College Events</option>
                    <option>Participated in District Events</option>
                    <option>Participated in State/National Events</option>
                </select>
            </div>

            <div class="input-group">
                <label for="additionalInfo">Additional Information</label>
                <textarea id="additionalInfo" name="additionalInfo"
                          rows="3"
                          placeholder="Any additional information (optional)"></textarea>
            </div>

            <div class="checkbox-group">
                <label>
                    <input type="checkbox" id="terms" required>
                    I agree to the competition rules and regulations. *
                </label>
            </div>

            <div class="btn-group">
                <button type="submit" class="submit-btn">
                    Register Now
                </button>

                <button type="reset" class="reset-btn">
                    Reset Form
                </button>
            </div>

            <div class="success-message" id="successMessage"
                 role="status" aria-live="polite">
            </div>

        </form>
    </div>

    <div class="footer2">
        © 2026 Shayari Competition | All Rights Reserved
    </div>

</div>

<script>
    const shayariForm = document.getElementById("shayariForm");
    const successMessage = document.getElementById("successMessage");

    shayariForm.addEventListener("submit", function(event) {
        event.preventDefault();

        const name = document.getElementById("fullName").value;
        const type = document.getElementById("shayariType").value;
        const title = document.getElementById("title").value;

        successMessage.style.display = "block";
        successMessage.textContent =
            "Thank you, " + name +
            "! Your Shayari registration form has been submitted successfully. " +
            "Type: " + type + " | Title: " + title;

        successMessage.scrollIntoView({
            behavior: "smooth",
            block: "nearest"
        });
    });

    shayariForm.addEventListener("reset", function() {
        successMessage.style.display = "none";
        successMessage.textContent = "";
    });
</script>
</body>
</html>