<%- include('partial/head') %>
<style>
.container2 {
    max-width: 750px;
    margin: auto;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.35);
}
.header2 {
    text-align: center;
    padding: 35px 20px;
    color: #fff;
    background: linear-gradient(135deg, #78350f, #b45309);
}
.icon {
    font-size: 55px;
    margin-bottom: 10px;
}
.header h1 {
    font-size: 30px;
    letter-spacing: 2px;
}
.header h2 {
    margin-top: 10px;
    color: #fde68a;
    font-size: 22px;
}
.header p {
    margin-top: 12px;
    font-size: 14px;
}
form {
    padding: 30px;
}
form h3 {
    color: #78350f;
    margin: 12px 0 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid #d97706;
}
.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}
.input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
}
label {
    color: #292524;
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 8px;
}
input,
select,
textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #d6d3d1;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: 0.3s;
}
input:focus,
select:focus,
textarea:focus {
    border-color: #b45309;
    box-shadow: 0 0 0 3px rgba(180, 83, 9, 0.12);
}
textarea {
    resize: vertical;
}
.checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 15px 0 25px;
}
.checkbox input {
    width: auto;
    margin-top: 3px;
}
.checkbox label {
    font-weight: normal;
    line-height: 1.5;
}
button {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    background: #92400e;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}
button:hover {
    background: #78350f;
    transform: translateY(-2px);
}
.reset-btn {
    margin-top: 12px;
    background: #e7e5e4;
    color: #292524;
}
.reset-btn:hover {
    background: #d6d3d1;
}
#successMessage {
    color: #15803d;
    text-align: center;
    font-weight: bold;
    line-height: 1.7;
    margin-top: 20px;
}
footer {
    text-align: center;
    padding: 20px;
    background: #292019;
    color: white;
    font-size: 13px;
    line-height: 1.8;
}
@media (max-width: 600px) {
    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }
    form {
        padding: 22px;
    }
    .header h1 {
        font-size: 24px;
    }
    .header h2 {
        font-size: 19px;
    }
}
</style>
</head>
<body>
  <header class="bg-red-500 text-white p-4 shadow-md">
    <nav class="container mx-auto flex justify-between items-center">
      <ul class="flex space-x-4"> 
        <li>
          <a href="/home" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Home</a>
        </li>
        <li>
          <a href="/cricket"><h2 class="Logo">Cricket</h2></a>
        </li>
        <li>
          <a href="/badminton" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Badminton</a>
        </li>
        <li>
          <a href="/volleyball" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Volleyball</a>
        </li>
        <li>
          <a href="/chess" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Chess</a>
        </li>
        <li>
          <a href="/tug-of-war" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Tug of War</a>
        </li>
        <li>
          <a href="/carrom" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Carrom</a>
        </li>
        <li>
          <a href="/kabbadi" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Kabbadi</a>
        </li>
        <li>
          <a href="/pubge" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Pubg</a>
        </li>
        <li>
          <a href="/free-fire" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Free fire</a>
        </li>
        <li>
          <a href="/long-jump" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Long jump</a>
        </li>
        <li>
          <a href="/high-jump" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">High jump</a>
        </li>
        <li>
          <a href="/high-jump" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Jablin Throw</a>
        </li>
      </ul>
    </nav>
  </header>
<div class="container2">
    <header class="header2">
        <div class="icon">🎯</div>
        <h1>CARROM CHAMPIONSHIP</h1>
        <h2>TOURNAMENT 2026</h2>
        <p>Focus • Precision • Victory</p>
    </header>
    <form id="carromForm">
        <h3>👤 Player Information</h3>
        <div class="form-row">
            <div class="input-group">
                <label for="name">Full Name *</label>
                <input type="text" id="name"
                       placeholder="Enter your full name" required>
            </div>
            <div class="input-group">
                <label for="email">Email Address *</label>
                <input type="email" id="email"
                       placeholder="Enter your email" required>
            </div>
        </div>
        <div class="form-row">
            <div class="input-group">
                <label for="phone">Mobile Number *</label>
                <input type="tel" id="phone"
                       placeholder="10-digit number"
                       pattern="[0-9]{10}" required>
            </div>
            <div class="input-group">
                <label for="age">Age *</label>
                <input type="number" id="age"
                       min="13" max="100"
                       placeholder="Enter your age" required>
            </div>
        </div>
        <div class="input-group">
            <label for="city">City *</label>
            <input type="text" id="city"
                   placeholder="Enter your city" required>
        </div>
        <h3>🏆 Tournament Information</h3>
        <div class="form-row">
            <div class="input-group">
                <label for="category">Playing Category *</label>
                <select id="category" required>
                    <option value="">Select Category</option>
                    <option value="Singles">Singles</option>
                    <option value="Doubles">Doubles</option>
                    <option value="Team">Team Championship</option>
                </select>
            </div>
            <div class="input-group">
                <label for="level">Playing Level *</label>
                <select id="level" required>
                    <option value="">Select Level</option>
                    <option value="Beginner">Beginner</option>
                    <option value="Intermediate">Intermediate</option>
                    <option value="Advanced">Advanced</option>
                    <option value="Professional">Professional</option>
                </select>
            </div>
        </div>
        <div class="input-group">
            <label for="team">Team / Partner Name</label>
            <input type="text" id="team"
                   placeholder="Enter team or doubles partner name">
        </div>
        <div class="input-group">
            <label for="organization">School / College / Club</label>
            <input type="text" id="organization"
                   placeholder="Enter your organization">
        </div>
        <div class="input-group">
            <label for="experience">Playing Experience *</label>
            <select id="experience" required>
                <option value="">Select Experience</option>
                <option value="Beginner">Beginner</option>
                <option value="1-3 Years">1–3 Years</option>
                <option value="3-5 Years">3–5 Years</option>
                <option value="5+ Years">5+ Years</option>
            </select>
        </div>
        <div class="input-group">
            <label for="message">Additional Information</label>
            <textarea id="message" rows="3"
                      placeholder="Any additional details..."></textarea>
        </div>
        <div class="checkbox">
            <input type="checkbox" id="terms" required>
            <label for="terms">
                I confirm that my information is correct and
                I agree to follow the tournament rules.
            </label>
        </div>
        <button type="submit">Register Now →</button>
        <button type="reset" class="reset-btn">Reset Form</button>
        <p id="successMessage" role="status"></p>
    </form>
    <footer>
        <p>🎯 Aim Carefully. Strike Perfectly. Win Proudly.</p>
        <p>© 2026 Carrom Championship</p>
    </footer>
</div>
<script>
const form = document.getElementById("carromForm");
const successMessage = document.getElementById("successMessage");
form.addEventListener("submit", function (event) {
    event.preventDefault();
    const name = document.getElementById("name").value.trim();
    const category = document.getElementById("category").value;
    const level = document.getElementById("level").value;
    successMessage.textContent =
        `Registration successful! Welcome ${name}. ` +
        `Category: ${category} | Level: ${level}`;
    form.reset();
});
form.addEventListener("reset", function () {
    successMessage.textContent = "";
});
</script>
</body>
</html>