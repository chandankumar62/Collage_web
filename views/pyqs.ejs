<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BEU Student Portal</title>

    <style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #222;
    line-height: 1.6;
}

/* Header */

.header {
    background: #123b70;
    color: white;
    text-align: center;
    padding: 30px 15px;
}

.header h1 {
    margin-bottom: 8px;
}

/* Navigation */

.navbar {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
    background: #0b2850;
    padding: 14px;
}

.navbar a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

.navbar a:hover {
    color: #ffd166;
}

/* Home page */

.home-container {
    max-width: 1100px;
    margin: auto;
    padding: 30px 20px;
}

.hero {
    background: white;
    text-align: center;
    padding: 55px 20px;
    border-radius: 12px;
    box-shadow: 0 4px 15px #00000010;
}

.hero h2 {
    color: #123b70;
    font-size: 30px;
    margin-bottom: 12px;
}

.hero p {
    margin-bottom: 25px;
}

.features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 30px;
}

.feature-card {
    background: white;
    padding: 25px;
    border-radius: 10px;
    text-align: center;
    box-shadow: 0 3px 12px #00000010;
}

.feature-card h3 {
    color: #123b70;
    margin-bottom: 10px;
}

/* Common buttons */

.btn {
    display: inline-block;
    background: #123b70;
    color: white;
    text-decoration: none;
    padding: 10px 16px;
    border-radius: 6px;
    transition: background 0.3s;
}

.btn:hover {
    background: #20549a;
}

.download-btn {
    background: #198754;
}

.download-btn:hover {
    background: #126c42;
}

/* PYQ page */

.container {
    max-width: 1100px;
    margin: auto;
    padding: 30px 20px;
}

.page-title {
    text-align: center;
    color: #123b70;
    margin-bottom: 25px;
}

.filters {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 15px;
    margin-bottom: 30px;
}

.filters input,
.filters select {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccd3dd;
    border-radius: 6px;
    font-size: 15px;
    background: white;
}

/* PYQ cards */

.pyq-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
}

.pyq-card {
    background: white;
    padding: 22px;
    border-radius: 10px;
    box-shadow: 0 3px 12px #00000010;
    transition: transform 0.3s;
}

.pyq-card:hover {
    transform: translateY(-4px);
}

.pyq-card h3 {
    color: #123b70;
    margin-bottom: 12px;
}

.pyq-card p {
    color: #555;
    margin-bottom: 5px;
}

.card-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 15px;
}

.card-buttons .btn {
    text-align: center;
    font-size: 14px;
}

.no-results {
    text-align: center;
    padding: 25px;
    font-size: 18px;
}

/* Footer */

.footer {
    background: #123b70;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 35px;
}

/* Responsive design */

@media (max-width: 800px) {
    .features {
        grid-template-columns: repeat(2, 1fr);
    }

    .pyq-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .filters {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 550px) {
    .features,
    .pyq-list {
        grid-template-columns: 1fr;
    }

    .hero h2 {
        font-size: 24px;
    }

    .navbar {
        gap: 15px;
    }
}
    </style>
</head>

<body>
    <header class="header">
        <h1>BEU Student Portal</h1>
        <p>Bihar Engineering University, Patna</p>
    </header>

    <nav class="navbar">
        <a href="/home">Home</a>
        <a href="pyq.html">Previous Year Questions</a>
    </nav>

    <main class="home-container">

        <section class="hero">
            <h2>Welcome to BEU Student Portal</h2>

            <p>
                Find Previous Year Question Papers
                for your engineering semester.
            </p>

            <a href="pyq.html" class="btn">
                Explore BEU PYQs
            </a>
        </section>

        <section class="features">

            <div class="feature-card">
                <h3>📚 Previous Year Papers</h3>
                <p>Find subject-wise question papers.</p>
            </div>

            <div class="feature-card">
                <h3>🎓 Semester Wise</h3>
                <p>Choose papers according to your semester.</p>
            </div>

            <div class="feature-card">
                <h3>📄 PDF Download</h3>
                <p>Open and download available question papers.</p>
            </div>

        </section>

    </main>

    <footer class="footer">
        <p>BEU Student Portal | Study Smart, Score Better</p>
    </footer>

</body>

</html>