<%- include('partial/head') %>
<style>
.container2 {
    max-width: 760px;
    margin: auto;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
}
.header2 {
    text-align: center;
    padding: 35px 20px;
    color: #fff;
    background: linear-gradient(135deg, #b91c1c, #ea580c);
}
.icon {
    font-size: 55px;
    margin-bottom: 10px;
}
.header h1 {
    font-size: 30px;
    letter-spacing: 2px;
}
.header h2 {
    margin-top: 10px;
    color: #fde68a;
    font-size: 22px;
}
.header p {
    margin-top: 12px;
    font-size: 14px;
}
form {
    padding: 30px;
}
form h3 {
    color: #991b1b;
    margin: 12px 0 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid #f97316;
}
.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}
.input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
}
label {
    color: #292524;
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 8px;
}
input,
select {
    width: 100%;
    padding: 12px;
    border: 1px solid #d6d3d1;
    border-radius: 8px;
    outline: none;
    font-size: 14px;
    background: #fff;
    transition: 0.3s;
}
input:focus,
select:focus {
    border-color: #ea580c;
    box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.12);
}
.info {
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
    margin: -8px 0 18px;
}
.player-field {
    margin-bottom: 15px;
}
.player-field label {
    display: block;
    margin-bottom: 8px;
}
.checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 15px 0 25px;
}
.checkbox input {
    width: auto;
    margin-top: 3px;
}
.checkbox label {
    font-weight: normal;
    line-height: 1.5;
}
button {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    background: #b91c1c;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}
button:hover {
    background: #7f1d1d;
    transform: translateY(-2px);
}
.reset-btn {
    margin-top: 12px;
    background: #e7e5e4;
    color: #292524;
}
.reset-btn:hover {
    background: #d6d3d1;
}
#successMessage {
    color: #15803d;
    text-align: center;
    font-weight: bold;
    line-height: 1.7;
    margin-top: 20px;
}
footer {
    text-align: center;
    padding: 20px;
    background: #451a03;
    color: white;
    font-size: 13px;
    line-height: 1.8;
}
@media (max-width: 600px) {
    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }
    form {
        padding: 22px;
    }
    .header h1 {
        font-size: 24px;
    }
    .header h2 {
        font-size: 19px;
    }
}
</style>
</head>
<body>
  <header class="bg-red-500 text-white p-4 shadow-md">
    <nav class="container mx-auto flex justify-between items-center">
      <ul class="flex space-x-4"> 
        <li>
          <a href="/sports-home" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Home</a>
        </li>
        <li>
          <a href="/cricket"><h2 class="Logo">Cricket</h2></a>
        </li>
        <li>
          <a href="/badminton" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Badminton</a>
        </li>
        <li>
          <a href="/volleyball" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Volleyball</a>
        </li>
        <li>
          <a href="/chess" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Chess</a>
        </li>
        <li>
          <a href="/tug-of-war" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Tug of War</a>
        </li>
        <li>
          <a href="/carrom" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Carrom</a>
        </li>
        <li>
          <a href="/kabbadi" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Kabbadi</a>
        </li>
        <li>
          <a href="/pubg" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Pubg</a>
        </li>
        <li>
          <a href="/free-fire" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Free fire</a>
        </li>
        <li>
          <a href="/long-jump" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Long jump</a>
        </li>
        <li>
          <a href="/high-jump" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">High jump</a>
        </li>
        <li>
          <a href="/high-jump" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Jablin Throw</a>
        </li>
      </ul>
    </nav>
  </header>
<div class="container2">
    <header class="header2">
        <div class="icon">🤼</div>
        <h1>KABADDI CHAMPIONSHIP</h1>
        <h2>TOURNAMENT 2026</h2>
        <p>Strength • Strategy • Teamwork</p>
    </header>
    <form id="kabaddiForm">
        <h3>👤 Captain Information</h3>
        <div class="form-row">
            <div class="input-group">
                <label for="captain">Captain's Full Name *</label>
                <input type="text" id="captain"
                       placeholder="Enter captain's name" required>
            </div>
            <div class="input-group">
                <label for="email">Email Address *</label>
                <input type="email" id="email"
                       placeholder="Enter email address" required>
            </div>
        </div>
        <div class="form-row">
            <div class="input-group">
                <label for="phone">Mobile Number *</label>
                <input type="tel" id="phone"
                       placeholder="10-digit mobile number"
                       pattern="[0-9]{10}" required>
            </div>
            <div class="input-group">
                <label for="city">City *</label>
                <input type="text" id="city"
                       placeholder="Enter your city" required>
            </div>
        </div>
        <h3>🏆 Team Information</h3>
        <div class="form-row">
            <div class="input-group">
                <label for="team">Team Name *</label>
                <input type="text" id="team"
                       placeholder="Enter team name" required>
            </div>
            <div class="input-group">
                <label for="organization">School / College / Club</label>
                <input type="text" id="organization"
                       placeholder="Enter organization">
            </div>
        </div>
        <div class="form-row">
            <div class="input-group">
                <label for="category">Team Category *</label>
                <select id="category" required>
                    <option value="">Select Category</option>
                    <option value="Men">Men</option>
                    <option value="Women">Women</option>
                </select>
            </div>
            <div class="input-group">
                <label for="ageGroup">Age Category *</label>
                <select id="ageGroup" required>
                    <option value="">Select Age Category</option>
                    <option value="Under 14">Under 14</option>
                    <option value="Under 16">Under 16</option>
                    <option value="Under 18">Under 18</option>
                    <option value="Open">Open Category</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="input-group">
                <label for="role">Playing Position *</label>
                <select id="role" required>
                    <option value="">Select Position</option>
                    <option value="Raider">Raider</option>
                    <option value="Defender">Defender</option>
                    <option value="All-Rounder">All-Rounder</option>
                </select>
            </div>
            <div class="input-group">
                <label for="experience">Playing Experience *</label>
                <select id="experience" required>
                    <option value="">Select Experience</option>
                    <option value="Beginner">Beginner</option>
                    <option value="1-3 Years">1–3 Years</option>
                    <option value="3-5 Years">3–5 Years</option>
                    <option value="5+ Years">5+ Years</option>
                </select>
            </div>
        </div>
        <h3>💪 Team Members</h3>
        <p class="info">
            Select your squad size and enter the names of the players.
            The tournament organizer should confirm the permitted squad
            size and official eligibility rules.
        </p>
        <div class="input-group">
            <label for="playerCount">Squad Size *</label>
            <select id="playerCount" required>
                <option value="">Select Squad Size</option>
                <option value="7">7 Players</option>
                <option value="10">10 Players</option>
                <option value="12">12 Players</option>
            </select>
        </div>
        <div id="playersContainer"></div>
        <h3>📋 Declaration</h3>
        <div class="checkbox">
            <input type="checkbox" id="terms" required>
            <label for="terms">
                I confirm that the provided information is correct
                and our team will follow the tournament rules.
            </label>
        </div>
        <button type="submit">Register Team →</button>
        <button type="reset" class="reset-btn">Reset Form</button>
        <p id="successMessage" role="status"></p>
    </form>
    <footer>
        <p>💪 Play with Passion. Fight with Teamwork.</p>
        <p>© 2026 Kabaddi Championship</p>
    </footer>
</div>
<script>
const form = document.getElementById("kabaddiForm");
const playerCount = document.getElementById("playerCount");
const playersContainer = document.getElementById("playersContainer");
const successMessage = document.getElementById("successMessage");
playerCount.addEventListener("change", function () {
    const count = Number(playerCount.value);
    playersContainer.replaceChildren();
    for (let i = 1; i <= count; i++) {
        const wrapper = document.createElement("div");
        wrapper.className = "player-field";
        const label = document.createElement("label");
        label.htmlFor = `player${i}`;
        label.textContent = `Player ${i} Name *`;
        const input = document.createElement("input");
        input.type = "text";
        input.id = `player${i}`;
        input.name = `player${i}`;
        input.placeholder = `Enter player ${i} name`;
        input.required = true;
        wrapper.append(label, input);
        playersContainer.appendChild(wrapper);
    }
});
form.addEventListener("submit", function (event) {
    event.preventDefault();
    const captain = document.getElementById("captain").value.trim();
    const team = document.getElementById("team").value.trim();
    const category = document.getElementById("category").value;
    const role = document.getElementById("role").value;
    const count = Number(playerCount.value);
    successMessage.textContent =
        `Registration successful! Team: ${team}. ` +
        `Captain: ${captain}. Category: ${category}. ` +
        `Captain's Role: ${role}. Squad Size: ${count}.`;
    form.reset();
    playersContainer.replaceChildren();
});
form.addEventListener("reset", function () {
    successMessage.textContent = "";
    playersContainer.replaceChildren();
});
</script>
</body>
</html>
