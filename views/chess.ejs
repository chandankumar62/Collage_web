<%- include('partial/head') %>
<style>
 .container2 {
    max-width: 750px;
    margin: auto;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.35);
}
.header2 {
    background: linear-gradient(135deg, #141e30, #344563);
    color: white;
    text-align: center;
    padding: 35px 20px;
}
.chess-icon {
    font-size: 65px;
    margin-bottom: 10px;
}
.header h1 {
    font-size: 32px;
    letter-spacing: 3px;
}
.header h2 {
    margin-top: 10px;
    color: #f4ca64;
    font-size: 22px;
}
.header p {
    margin-top: 15px;
    font-size: 14px;
    line-height: 1.5;
}
form {
    padding: 30px;
}
form h3 {
    color: #263653;
    margin: 10px 0 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid #d6ad45;
}
.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}
.input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
}
label {
    font-size: 14px;
    font-weight: bold;
    color: #263238;
    margin-bottom: 8px;
}
input,
select,
textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccd2dc;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: 0.3s;
}
input:focus,
select:focus,
textarea:focus {
    border-color: #344563;
    box-shadow: 0 0 0 3px rgba(52, 69, 99, 0.12);
}
textarea {
    resize: vertical;
}
.checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 10px 0 25px;
}
.checkbox input {
    width: auto;
    margin-top: 2px;
}
.checkbox label {
    font-weight: normal;
    line-height: 1.5;
}
button {
    width: 100%;
    padding: 14px;
    background: #263653;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}
button:hover {
    background: #141e30;
    transform: translateY(-2px);
}
.reset-btn {
    margin-top: 12px;
    background: #e9edf2;
    color: #263653;
}
.reset-btn:hover {
    background: #d6dce5;
}
#successMessage {
    margin-top: 20px;
    color: #187747;
    text-align: center;
    font-weight: bold;
    line-height: 1.7;
}
footer {
    background: #141e30;
    color: white;
    text-align: center;
    padding: 20px;
    font-size: 13px;
    line-height: 1.8;
}
@media (max-width: 600px) {
    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }
    form {
        padding: 22px;
    }
    .header h1 {
        font-size: 25px;
    }
    .header h2 {
        font-size: 19px;
    }
}
</style>
</head>
<body>
  <header class="bg-red-500 text-white p-4 shadow-md">
    <nav class="container mx-auto flex justify-between items-center">
      <ul class="flex space-x-4"> 
        <li>
          <a href="/home" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Home</a>
        </li>
        <li>
          <a href="/cricket"><h2 class="Logo">Cricket</h2></a>
        </li>
        <li>
          <a href="/badminton" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Badminton</a>
        </li>
        <li>
          <a href="/volleyball" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Volleyball</a>
        </li>
        <li>
          <a href="/chess" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Chess</a>
        </li>
        <li>
          <a href="/tug-of-war" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Tug of War</a>
        </li>
        <li>
          <a href="/carrom" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Carrom</a>
        </li>
        <li>
          <a href="/kabbadi" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Kabbadi</a>
        </li>
        <li>
          <a href="/pubge" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Pubg</a>
        </li>
        <li>
          <a href="/free-fire" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Free fire</a>
        </li>
        <li>
          <a href="/long-jump" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Long jump</a>
        </li>
        <li>
          <a href="/high-jump" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">High jump</a>
        </li>
        <li>
          <a href="/high-jump" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Jablin Throw</a>
        </li>
      </ul>
    </nav>
  </header>
    <div class="container2">
        <header class="header2">
            <div class="chess-icon">♟</div>
            <h1>CHESS MASTERS</h1>
            <h2>TOURNAMENT 2026</h2>
            <p>Think Smart. Play Strong. Become a Champion.</p>
        </header>
        <form id="chessForm">
            <h3>♙ Player Information</h3>
            <div class="form-row">
                <div class="input-group">
                    <label for="name">Full Name *</label>
                    <input type="text" id="name"
                           placeholder="Enter your full name" required>
                </div>
                <div class="input-group">
                    <label for="email">Email Address *</label>
                    <input type="email" id="email"
                           placeholder="Enter your email" required>
                </div>
            </div>
            <div class="form-row">
                <div class="input-group">
                    <label for="phone">Mobile Number *</label>
                    <input type="tel" id="phone"
                           placeholder="10-digit mobile number"
                           pattern="[0-9]{10}" required>
                </div>
                <div class="input-group">
                    <label for="age">Age *</label>
                    <input type="number" id="age"
                           min="13" max="100"
                           placeholder="Enter your age" required>
                </div>
            </div>
            <div class="input-group">
                <label for="city">City *</label>
                <input type="text" id="city"
                       placeholder="Enter your city" required>
            </div>
            <h3>♜ Chess Information</h3>
            <div class="form-row">
                <div class="input-group">
                    <label for="level">Playing Level *</label>
                    <select id="level" required>
                        <option value="">Select Level</option>
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                        <option value="Expert">Expert</option>
                    </select>
                </div>
                <div class="input-group">
                    <label for="rating">Chess Rating (Optional)</label>
                    <input type="number" id="rating"
                           min="0" placeholder="Enter rating if available">
                </div>
            </div>
            <div class="input-group">
                <label for="club">Chess Club / School / College</label>
                <input type="text" id="club"
                       placeholder="Enter your institution">
            </div>
            <h3>🏆 Tournament Details</h3>
            <div class="form-row">
                <div class="input-group">
                    <label for="category">Tournament Category *</label>
                    <select id="category" required>
                        <option value="">Select Category</option>
                        <option value="Open">Open Category</option>
                        <option value="Under 18">Under 18</option>
                        <option value="Under 16">Under 16</option>
                        <option value="Under 14">Under 14</option>
                    </select>
                </div>
                <div class="input-group">
                    <label for="format">Chess Format *</label>

                    <select id="format" required>
                        <option value="">Select Format</option>
                        <option value="Rapid">Rapid Chess</option>
                        <option value="Blitz">Blitz Chess</option>
                        <option value="Classical">Classical Chess</option>
                    </select>
                </div>
            </div>
            <div class="input-group">
                <label for="experience">Previous Tournament Experience *</label>
                <select id="experience" required>
                    <option value="">Select Experience</option>
                    <option value="First Tournament">First Tournament</option>
                    <option value="1-3 Tournaments">1-3 Tournaments</option>
                    <option value="4+ Tournaments">4+ Tournaments</option>
                </select>
            </div>
            <div class="input-group">
                <label for="message">Additional Information</label>
                <textarea id="message" rows="3"
                          placeholder="Any additional information..."></textarea>
            </div>
            <div class="checkbox">
                <input type="checkbox" id="terms" required>
                <label for="terms">
                    I confirm that my information is correct and agree
                    to follow the tournament rules.
                </label>
            </div>
            <button type="submit">Register Now ♟</button>
            <button type="reset" class="reset-btn">Reset Form</button>
            <div id="successMessage" role="status"></div>
        </form>
        <footer>
            <p>♟ Every Move Counts!</p>
            <p>© 2026 Chess Masters Tournament</p>
        </footer>
    </div>
    <script>
const form = document.getElementById("chessForm");
const successMessage = document.getElementById("successMessage");
form.addEventListener("submit", function (event) {
    event.preventDefault();
    const name = document.getElementById("name").value.trim();
    const level = document.getElementById("level").value;
    const category = document.getElementById("category").value;
    const format = document.getElementById("format").value;
    successMessage.textContent =
        `Registration successful! Welcome ${name}. ` +
        `Level: ${level} | Category: ${category} | Format: ${format}`;
    form.reset();
});
form.addEventListener("reset", function () {
    successMessage.textContent = "";
});
    </script>
</body>
</html>
