<%- include('partial/head') %>
<style>
body {
    font-family: Arial, sans-serif;
    background: #f4f6f9;
}
.calendar-container {
    width: 95%;
    max-width: 900px;
    margin: 40px auto;
    background: white;
    border-radius: 20px;
    padding: 25px;
    box-shadow: 0 10px 35px rgba(0,0,0,0.12);
}
.calendar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #e53935, #ff7043);
    color: white;
    padding: 20px;
    border-radius: 15px;
}
.calendar-header h2 {
    font-size: 28px;
    text-align: center;
}
.calendar-header p {
    text-align: center;
    margin-top: 5px;
    opacity: 0.9;
}
.calendar-header button {
    width: 45px;
    height: 45px;
    border: none;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    color: white;
    font-size: 30px;
    cursor: pointer;
}
.calendar-header button:hover {
    background: white;
    color: #e53935;
}
.legend {
    display: flex;
    gap: 20px;
    margin: 20px 0;
    justify-content: center;
    flex-wrap: wrap;
}
.legend span {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
}
.legend i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
}
.holiday {
    background: #ef4444;
}
.exam {
    background: #8b5cf6;
}
.today {
    background: #2563eb;
}
.weekdays,
.calendar {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
}
.weekdays div {
    text-align: center;
    font-weight: bold;
    color: #555;
    padding: 10px;
}
.date {
    min-height: 75px;
    border: 1px solid #eee;
    border-radius: 12px;
    padding: 10px;
    background: #fafafa;
    cursor: pointer;
    transition: 0.2s;
}
.date:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
}
.empty {
    background: transparent;
    border: none;
}
.today-date {
    border: 3px solid #2563eb;
}
.holiday-date {
    background: #fee2e2;
    border-color: #ef4444;
}
.exam-date {
    background: #ede9fe;
    border-color: #8b5cf6;
}
.date-number {
    font-weight: bold;
    font-size: 17px;
}
.event-name {
    display: block;
    font-size: 11px;
    margin-top: 8px;
    color: #dc2626;
}
.event-box {
    margin-top: 20px;
    padding: 15px;
    background: #f8fafc;
    border-radius: 12px;
    color: #555;
}
@media (max-width: 600px) {
    .calendar-container {
        padding: 15px;
        margin: 15px auto;
    }
    .calendar-header h2 {
        font-size: 20px;
    }
    .date {
        min-height: 60px;
        padding: 6px;
    }
    .event-name {
        font-size: 9px;
    }
    .weekdays,
    .calendar {
        gap: 4px;
    }
}
</style>
</head>
<body>   
  <%- include('partial/header') %>
  <div class="calendar-container">
  <div class="calendar-header">
    <button id="prevMonth">‹</button>
    <div>
      <h2 id="monthYear"></h2>
      <p>BEU Academic Calendar</p>
    </div>
    <button id="nextMonth">›</button>
  </div>
  <div class="legend">
    <span><i class="holiday"></i> Holiday</span>
    <span><i class="exam"></i> Exam</span>
    <span><i class="today"></i> Today</span>
  </div>
  <div class="weekdays">
    <div>Sun</div>
    <div>Mon</div>
    <div>Tue</div>
    <div>Wed</div>
    <div>Thu</div>
    <div>Fri</div>
    <div>Sat</div>
  </div>
  <div id="calendar" class="calendar"></div>
  <div id="eventBox" class="event-box">
    Select a date
  </div>
</div>
<script>
  const holidays = {
    "2026-10-02": "Gandhi Jayanti",
    "2026-10-20": "Durga Puja",
    "2026-10-21": "Durga Puja",
    "2026-10-22": "Durga Puja",
    "2026-11-08": "Diwali",
    "2026-11-09": "Govardhan Puja",
    "2026-11-15": "Chhath Puja"
};
const exams = {
    "2026-12-01": "End Semester Exam",
    "2026-12-03": "End Semester Exam"
};
let currentDate = new Date();
const calendar = document.getElementById("calendar");
const monthYear = document.getElementById("monthYear");
const eventBox = document.getElementById("eventBox");
function formatDate(year, month, day) {
    let m = String(month + 1).padStart(2, "0");
    let d = String(day).padStart(2, "0");
    return `${year}-${m}-${d}`;
}
function renderCalendar() {
    calendar.innerHTML = "";
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    const firstDay = new Date(year, month, 1).getDay();
    const totalDays = new Date(year, month + 1, 0).getDate();
    monthYear.innerText =
        currentDate.toLocaleString("en-US", {
            month: "long",
            year: "numeric"
        });
    // Empty boxes
    for (let i = 0; i < firstDay; i++) {
        const empty = document.createElement("div");
        empty.classList.add("date", "empty");
        calendar.appendChild(empty);
    }
    for (let day = 1; day <= totalDays; day++) {
        const date = document.createElement("div");
        date.classList.add("date");
        const dateKey = formatDate(year, month, day);
        const number = document.createElement("div");
        number.classList.add("date-number");
        number.innerText = day;
        date.appendChild(number);
        // Today
        const today = new Date();
        if (
            day === today.getDate() &&
            month === today.getMonth() &&
            year === today.getFullYear()
        ) {
            date.classList.add("today-date");
        }
        // Holiday
        if (holidays[dateKey]) {
            date.classList.add("holiday-date");
            const event = document.createElement("span");
            event.classList.add("event-name");
            event.innerText = holidays[dateKey];
            date.appendChild(event);
        }
        // Exam
        if (exams[dateKey]) {
            date.classList.add("exam-date");
            const event = document.createElement("span");
            event.classList.add("event-name");
            event.innerText = exams[dateKey];
            date.appendChild(event);
        }
        // Click
        date.addEventListener("click", () => {
            if (holidays[dateKey]) {
                eventBox.innerHTML =
                    `<strong>${day}</strong> — ${holidays[dateKey]}`;
            }
            else if (exams[dateKey]) {
                eventBox.innerHTML =
                `<strong>${day}</strong> — ${exams[dateKey]}`;
            }
            else {
                eventBox.innerHTML =
                `<strong>${day}</strong> — No event`;
            }
        });
        calendar.appendChild(date);
    }
}
document.getElementById("prevMonth").onclick = () => {
    currentDate.setMonth(currentDate.getMonth() - 1);
    renderCalendar();
};
document.getElementById("nextMonth").onclick = () => {
    currentDate.setMonth(currentDate.getMonth() + 1);
    renderCalendar();
};
renderCalendar();
</script>
</body>
</html>