<%- include('partial/head') %>
<style>
.container2 {
    max-width: 760px;
    margin: auto;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
}
.header2 {
    text-align: center;
    padding: 35px 20px;
    color: #fff;
    background: linear-gradient(135deg, #7c2d12, #ea580c);
}
.game-icon {
    font-size: 55px;
    margin-bottom: 10px;
}
.header h1 {
    font-size: 32px;
    letter-spacing: 3px;
}
.header h2 {
    margin-top: 10px;
    color: #fde68a;
    font-size: 22px;
}
.header p {
    margin-top: 12px;
    font-size: 14px;
}
form {
    padding: 30px;
}
form h3 {
    color: #9a3412;
    margin: 12px 0 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid #f97316;
}
.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}
.input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
}
label {
    color: #292524;
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 8px;
}
input,
select,
textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #d6d3d1;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: 0.3s;
}
input:focus,
select:focus,
textarea:focus {
    border-color: #ea580c;
    box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.12);
}
textarea {
    resize: vertical;
}
.checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 15px 0 25px;
}
.checkbox input {
    width: auto;
    margin-top: 3px;
}
.checkbox label {
    font-weight: normal;
    line-height: 1.5;
}
button {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    background: #ea580c;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}
button:hover {
    background: #9a3412;
    transform: translateY(-2px);
}
.reset-btn {
    margin-top: 12px;
    background: #e7e5e4;
    color: #292524;
}
.reset-btn:hover {
    background: #d6d3d1;
}
#successMessage {
    color: #15803d;
    text-align: center;
    font-weight: bold;
    line-height: 1.7;
    margin-top: 20px;
}
footer {
    text-align: center;
    padding: 20px;
    background: #101820;
    color: white;
    font-size: 13px;
    line-height: 1.8;
}
@media (max-width: 600px) {
    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }
    form {
        padding: 22px;
    }
    .header h1 {
        font-size: 25px;
    }
    .header h2 {
        font-size: 19px;
    }
}
</style>
</head>
<body>
  <header class="bg-red-500 text-white p-4 shadow-md">
    <nav class="container mx-auto flex justify-between items-center">
      <ul class="flex space-x-4"> 
        <li>
          <a href="/sports-home" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Home</a>
        </li>
        <li>
          <a href="/cricket"><h2 class="Logo">Cricket</h2></a>
        </li>
        <li>
          <a href="/badminton" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Badminton</a>
        </li>
        <li>
          <a href="/volleyball" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Volleyball</a>
        </li>
        <li>
          <a href="/chess" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Chess</a>
        </li>
        <li>
          <a href="/tug-of-war" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Tug of War</a>
        </li>
        <li>
          <a href="/carrom" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Carrom</a>
        </li>
        <li>
          <a href="/kabbadi" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Kabbadi</a>
        </li>
        <li>
          <a href="/pubge" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Pubg</a>
        </li>
        <li>
          <a href="/free-fire" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Free fire</a>
        </li>
        <li>
          <a href="/long-jump" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Long jump</a>
        </li>
        <li>
          <a href="/high-jump" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">High jump</a>
        </li>
        <li>
          <a href="/high-jump" class="hover:bg-red-400 py-2 px-4 rounded transition duration-300">Jablin Throw</a>
        </li>
      </ul>
    </nav>
  </header>
<div class="container2">
    <header class="header2">
        <div class="game-icon">🎮</div>
        <h1>ESPORTS ARENA</h1>
        <h2>TOURNAMENT 2026</h2>
        <p>Squad Up. Compete. Become a Champion.</p>
    </header>
    <form id="registrationForm">
        <h3>👤 Player Information</h3>
        <div class="form-row">
            <div class="input-group">
                <label for="name">Full Name *</label>
                <input type="text" id="name"
                       placeholder="Enter your full name" required>
            </div>
            <div class="input-group">
                <label for="email">Email Address *</label>
                <input type="email" id="email"
                       placeholder="Enter your email" required>
            </div>
        </div>
        <div class="form-row">
            <div class="input-group">
                <label for="phone">Mobile Number *</label>
                <input type="tel" id="phone"
                       placeholder="10-digit mobile number"
                       pattern="[0-9]{10}" required>
            </div>
            <div class="input-group">
                <label for="age">Age *</label>
                <input type="number" id="age"
                       min="13" max="100"
                       placeholder="Enter your age" required>
            </div>
        </div>
        <h3>🕹️ Game Information</h3>
        <div class="form-row">
            <div class="input-group">
                <label for="game">Select Game *</label>
                <select id="game" required>
                    <option value="">Choose Game</option>
                    <option value="BGMI">BGMI</option>
                    <option value="PUBG Mobile">PUBG Mobile</option>
                    <option value="PUBG PC">PUBG: Battlegrounds (PC)</option>
                </select>
            </div>
            <div class="input-group">
                <label for="mode">Game Mode *</label>
                <select id="mode" required>
                    <option value="">Select Mode</option>
                    <option value="Solo">Solo</option>
                    <option value="Duo">Duo</option>
                    <option value="Squad">Squad</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="input-group">
                <label for="ign">In-Game Name (IGN) *</label>
                <input type="text" id="ign"
                       placeholder="Enter your gaming name" required>
            </div>
            <div class="input-group">
                <label for="playerId">Player ID *</label>
                <input type="text" id="playerId"
                       placeholder="Enter your game ID" required>
            </div>
        </div>
        <div class="input-group">
            <label for="team">Team Name</label>
            <input type="text" id="team"
                   placeholder="Enter your team name">
        </div>
        <div class="input-group">
            <label for="experience">Tournament Experience *</label>
            <select id="experience" required>
                <option value="">Select Experience</option>
                <option value="Beginner">Beginner</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Experienced">Experienced</option>
            </select>
        </div>
        <h3>🏆 Tournament Details</h3>
        <div class="input-group">
            <label for="tournament">Tournament Type *</label>
            <select id="tournament" required>
                <option value="">Select Tournament</option>
                <option value="Friendly">Friendly Match</option>
                <option value="Online">Online Tournament</option>
                <option value="College">College Esports</option>
            </select>
        </div>
        <div class="input-group">
            <label for="message">Additional Information</label>
            <textarea id="message" rows="3"
                      placeholder="Tell us about your team..."></textarea>
        </div>
        <div class="checkbox">
            <input type="checkbox" id="terms" required>
            <label for="terms">
                I confirm that my registration information is correct
                and agree to follow the tournament rules.
            </label>
        </div>
        <button type="submit">Register for Tournament →</button>
        <button type="reset" class="reset-btn">Reset Form</button>
        <p id="successMessage" role="status"></p>
    </form>
    <footer>
        <p>🎯 Play Smart. Play Fair. Win Together.</p>
        <p>© 2026 Esports Arena</p>
    </footer>
</div>
<script>
const form = document.getElementById("registrationForm");
const successMessage = document.getElementById("successMessage");
form.addEventListener("submit", function (event) {
    event.preventDefault();
    const name = document.getElementById("name").value.trim();
    const ign = document.getElementById("ign").value.trim();
    const game = document.getElementById("game").value;
    const mode = document.getElementById("mode").value;
    const team = document.getElementById("team").value.trim();
    successMessage.textContent =
        `Registration successful! Welcome ${name} (${ign}). ` +
        `Game: ${game} | Mode: ${mode}` +
        (team ? ` | Team: ${team}` : "");
    form.reset();
});
form.addEventListener("reset", function () {
    successMessage.textContent = "";
});
</script>
</body>
</html>